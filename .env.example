VITE_SUPABASE_URL=your-project-url
VITE_SUPABASE_ANON_KEY=your-anon-key
# Optional: overrides Magic Link redirect target. Defaults to window.location.origin when omitted.
VITE_APP_URL=http://localhost:5173

# Local Hono API. VITE_BACKEND=supabase keeps the current app; hono uses VITE_API_URL.
VITE_API_URL=http://localhost:3030
VITE_BACKEND=supabase

# 4-digit PIN checked when showing hidden portfolio values. Restart the dev server after changing it.
VITE_VALUES_PIN=0000

# FMP API key for stock logos (edge function secret — NOT a VITE_ var).
# Set via: supabase secrets set FMP_API_KEY=your_key
# For local edge functions, add to supabase/functions/.env:
# FMP_API_KEY=your_key
# Logos are downloaded once and re-hosted in the public `stock-logos` Storage
# bucket (see migration 20260803160000) so clients never depend on FMP's
# CDN reliability. URLs are cached 24h in `stock_logo_cache`; rows still
# pointing at a raw provider URL are treated as stale and re-proxied.
# Uses SUPABASE_SERVICE_ROLE_KEY (auto-injected in edge functions).
