VITE_SUPABASE_URL=your-project-url
VITE_SUPABASE_ANON_KEY=your-anon-key
# Optional: overrides Magic Link redirect target. Defaults to window.location.origin when omitted.
VITE_APP_URL=http://localhost:5173

# Finnhub API key for stock logos (edge function secret — NOT a VITE_ var).
# Set via: supabase secrets set FINNHUB_API_KEY=your_key
# For local edge functions, add to supabase/.env:
# FINNHUB_API_KEY=your_key
FINNHUB_API_KEY=your-finnhub-api-key
