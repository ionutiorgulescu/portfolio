# Relative paths are resolved from the server/ directory.
SQLITE_PATH=data/portfolio.db
SESSION_SECRET=replace-with-a-long-random-secret
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
# Enables POST /auth/register. Keep false in production until email confirmation is in place.
ALLOW_REGISTRATION=false
# Set to true only when a reverse proxy (nginx, Caddy, load balancer) forwards requests to the API.
TRUST_PROXY=false

# SMTP for verification emails. Without SMTP_HOST, codes are printed to the server log (not allowed in production).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Portfolio <no-reply@example.com>"

# Postgres URI for `yarn import:supabase` (direct or session pooler). Server-only — not a VITE_ var.
SUPABASE_DB_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
