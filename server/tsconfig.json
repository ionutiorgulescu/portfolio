  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["index.ts", "auth.ts", "env.ts", "portfolios.ts", "positions.ts", "import-supabase.ts", "mailer.ts", "rate-limit.ts", "verification.ts", "db/**/*.ts", "scripts/**/*.ts", "drizzle.config.ts"]
}
